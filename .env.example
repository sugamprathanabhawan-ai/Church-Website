# ==============================================================================
# Sugam Church Platform — Environment Configuration Template
# Copy this file to .env and insert your real production / development keys.
# ==============================================================================

# 1. Supabase Client Configuration (Safe for client browsers)
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# 2. Server-Side Google Gemini API Key (Kept SECURE on server, never exposed to client)
# Used by backend /api/chat endpoint and Vite dev middleware
GEMINI_API_KEY=your_google_gemini_api_key

# 3. Optional Supabase Service Role Key (Server-side migrations & admin tasks)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
